exports[`resources and prompts wire format of 2026-07-28 gets the weather_report prompt 1`] = `
{
  "description": "A weather report for Madrid",
  "messages": [
    {
      "content": {
        "text": "Write a short, friendly weather report for Madrid from this data:",
        "type": "text",
      },
      "role": "user",
    },
    {
      "content": {
        "resource": {
          "mimeType": "application/json",
          "text": "{"city":"Madrid","temperature":14,"temperature_unit":"°C","conditions":"thunderstorm","humidity":42,"wind_speed":55,"wind_speed_unit":"km/h"}",
          "uri": "weather://Madrid",
        },
        "type": "resource",
      },
      "role": "user",
    },
  ],
  "resultType": "complete",
}
`;

