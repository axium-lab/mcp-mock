}
`;

exports[`resources and prompts wire format of 2026-07-28 lists resources, templates and prompts 2`] = `
{
  "cacheScope": "public",
  "resourceTemplates": [
    {
      "description": "The current weather of a city, as get_weather reports it. "weather://Atlantis" does not exist.",
      "mimeType": "application/json",
      "name": "weather",
      "title": "Current weather",
      "uriTemplate": "weather://{city}",
    },
    {
      "description": "A user profile, as get_user reports it. "user://missing" does not exist.",
      "mimeType": "application/json",
      "name": "user",
      "title": "User profile",
      "uriTemplate": "user://{user_id}",
    },
    {
      "description": "Any file of the fake file system read_file serves. "file:///missing" does not exist.",
      "name": "file",
      "title": "File",
      "uriTemplate": "file:///{path}",
    },
  ],
  "resultType": "complete",
  "ttlMs": 3600000,
}
`;

exports[`resources and prompts wire format of 2026-07-28 lists resources, templates and prompts 3`] = `
{
  "cacheScope": "public",
  "prompts": [
    {
      "arguments": [
        {
          "description": "The text to summarize.",
          "name": "text",
          "required": true,
          "title": "Text",
        },
        {
          "description": "brief or detailed. Defaults to brief.",
          "name": "style",
          "required": false,
          "title": "Style",
        },
      ],
      "description": "Asks for a summary of a text.",
      "name": "summarize",
      "title": "Summarize text",
    },
    {
      "arguments": [
        {
          "description": "The code to review.",
          "name": "code",
          "required": true,
          "title": "Code",
        },
        {
          "description": "The programming language, if known.",
          "name": "language",
          "required": false,
          "title": "Language",
        },
      ],
      "description": "Asks for a review of a piece of code.",
      "name": "code_review",
      "title": "Review code",
    },
    {
      "arguments": [
        {
          "description": "The city to report on.",
          "name": "city",
          "required": true,
          "title": "City",
        },
      ],
      "description": "Asks for a short weather report, with the city's weather embedded as a resource. "Atlantis" is never found.",
      "name": "weather_report",
      "title": "Weather report",
    },
  ],
  "resultType": "complete",
  "ttlMs": 3600000,
}
`;

