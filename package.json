{
  "name": "mcp-mock",
  "version": "0.0.0",
  "private": true,
  "description": "Mock MCP server for integration tests: point your MCP client at it, keep your code",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axium-lab/mcp-mock.git"
  },
  "homepage": "https://github.com/axium-lab/mcp-mock#readme",
  "bugs": {
    "url": "https://github.com/axium-lab/mcp-mock/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "start:node": "node src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "schemas:fetch": "bun scripts/fetch-schemas.ts"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2"
  }
}
